{
  "name": "@tsci/abse.g350-linux-handheld",
  "version": "1.1.0",
  "description": "Top-only G350 Linux handheld carrier with shared USB-C charging/data and Pi Zero 2 W microSD boot storage",
  "main": "index.circuit.tsx",
  "keywords": [
    "tscircuit",
    "circuit",
    "pcb",
    "electronics"
  ],
  "scripts": {
    "dev": "tsci dev",
    "build": "tsci build index.circuit.tsx --autorouter-debug --autorouter-dump-srj all --pcb-png --schematic-png --kicad-project",
    "snapshot": "tsci snapshot",
    "snapshot:update": "tsci snapshot --update",
    "start": "tsci dev",
    "typecheck": "tsc --noEmit",
    "compact:circuit": "node scripts/compact-circuit.mjs",
    "check:shorts": "tsci check shorts dist/index/circuit.json --mode gerber --layer all",
    "check:kicad": "node scripts/check-kicad.mjs",
    "fabrication": "node scripts/export-fabrication.mjs",
    "restore:models": "node scripts/restore-3d-models.mjs"
  },
  "devDependencies": {
    "@tscircuit/capacity-autorouter": "0.0.951",
    "tscircuit": "0.0.2715",
    "typescript": "5.9.3"
  },
  "author": "abse"
}
