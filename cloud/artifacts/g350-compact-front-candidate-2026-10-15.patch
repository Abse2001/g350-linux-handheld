+// Raster constructors are synchronous. Retain one bounded stamp buffer rather
+// than a fresh multi-megabyte array on every hard-grid cache miss.
+const maxRasterStampCells = 8_000_000
+let rasterStampBuffer = new Uint32Array(0)
+let rasterStampBorrowed = false
+function acquireRasterStamps(n: number) {
+  // A nested borrower must not alias or release the current owner's stamps.
+  if (rasterStampBorrowed || n > maxRasterStampCells)
+    return { stamps: new Uint32Array(n), release() {} }
+  rasterStampBorrowed = true
+  try {
+    if (rasterStampBuffer.length < n) rasterStampBuffer = new Uint32Array(n)
+    else rasterStampBuffer.fill(0, 0, n)
+  } catch (error) {
+    rasterStampBorrowed = false
+    throw error
+  }
+  let active = true
+  return {
+    stamps: rasterStampBuffer,
+    release() {
+      if (!active) return
+      active = false
+      rasterStampBorrowed = false
+    },
+  }
+}
