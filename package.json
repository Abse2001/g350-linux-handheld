{
  "name": "@tsci/abse.g350-linux-handheld",
  "version": "1.3.3",
  "description": "G350 bare-AM3352 Linux handheld in progress; native bus_lanes DDR3 bootstrap and historical routing experiments",
  "main": "index.circuit.tsx",
  "keywords": [
    "tscircuit",
    "circuit",
    "pcb",
    "electronics"
  ],
  "scripts": {
    "postinstall": "node scripts/patch-tscircuit-via-pad-check.mjs",
    "dev": "tsci dev",
    "build": "tsci build index.circuit.tsx --routing-disabled --disable-parts-engine --pcb-png --kicad-project",
    "snapshot": "tsci snapshot",
    "snapshot:update": "tsci snapshot --update",
    "start": "tsci dev",
    "typecheck": "node --max-old-space-size=6144 node_modules/typescript/bin/tsc --noEmit",
    "check:integrated-imports": "node scripts/check-integrated-imports.mjs",
    "build:memory": "tsci build experiments/am3352-ddr-clearance-bootstrap.circuit.tsx --autorouter-debug --autorouter-debug-dir dist/am3352-ddr-bootstrap --autorouter-dump-srj all --autorouter-timeout 2m --pcb-png --kicad-project",
    "check:am3352-imports": "node scripts/check-am3352-imports.mjs",
    "check:memory-escapes": "node scripts/check-memory-escapes.mjs dist/rk3566-memory-individual/phase-0.input.simple-route.json",
    "check:memory-connectivity": "node scripts/check-am3352-routing.mjs dist/index/circuit.json checks/integrated/am3352-active-memory-connectivity.json lib/am3352/memory-byte1-top-centered-swizzled-connections.json",
    "compact:circuit": "node scripts/compact-circuit.mjs",
    "check:shorts": "node scripts/check-am3352-ddr-active-source.mjs dist/index/circuit.json checks/integrated/am3352-ddr-active-source-equivalence.json && tsci check shorts dist/index/circuit.json --mode gerber --layer all",
    "check:kicad": "node scripts/check-kicad.mjs",
    "fabrication": "node scripts/export-fabrication.mjs",
    "restore:models": "node scripts/restore-3d-models.mjs",
    "check:memory-phase-copper": "bun scripts/check-memory-phase-vias.mjs dist/rk3566-memory-individual 37",
    "check:am3352-swizzle": "node scripts/check-am3352-swizzle.mjs",
    "check:rk3566-memory-connectivity": "node scripts/check-memory-routing.mjs",
    "build:host-netlist": "tsci build experiments/am3352-powered-host.circuit.tsx --routing-disabled --disable-parts-engine --inject-props '{\"schematicDisabled\":true}'",
    "check:power-netlist": "node scripts/check-am3352-power.mjs",
    "check:boot-netlist": "node scripts/check-am3352-boot.mjs",
    "check:storage-netlist": "node scripts/check-am3352-storage.mjs",
    "build:checked-routing": "tsci build index.circuit.tsx --routing-disabled --disable-parts-engine",
    "check:routing-evidence": "node scripts/summarize-am3352-reset-checks.mjs",
    "check:joint-breakout-evidence": "node scripts/summarize-am3352-joint-breakout-checks.mjs",
    "check:natural-command-fanouts": "node scripts/summarize-am3352-natural-command-fanout-checks.mjs",
    "check:command-terminals": "node scripts/summarize-am3352-command-terminals.mjs",
    "check:command-routing-evidence": "node scripts/summarize-am3352-command-checks.mjs",
    "check:command-byte-merge-holes": "node scripts/check-am3352-command-byte-merge-holes.mjs",
    "check:command-first-byte-breakouts": "node scripts/summarize-am3352-command-first-byte-checks.mjs",
    "check:rotated-breakout-evidence": "node scripts/summarize-am3352-rotated-breakout-checks.mjs",
    "check:rotated-byte0-evidence": "node scripts/summarize-am3352-rotated-byte0-checks.mjs",
    "check:rotated-cpu-reservations": "node scripts/summarize-am3352-rotated-breakout-checks.mjs byte1-cpu-reserved",
    "check:rotated-power-bridge-breakouts": "node scripts/summarize-am3352-power-bridge-breakout-checks.mjs",
    "check:rotated-byte1-evidence": "node scripts/summarize-am3352-rotated-byte1-checks.mjs pair",
    "check:rotated-byte1-matched-evidence": "node scripts/summarize-am3352-rotated-byte1-checks.mjs matched",
    "check:fixed-byte0-reservations": "node scripts/summarize-am3352-fixed-byte0-reservations-checks.mjs",
    "check:byte-swapped-byte0-evidence": "node scripts/summarize-am3352-byte-swapped-byte0-checks.mjs",
    "build:usbc-device-source": "tsci build experiments/am3352-usbc-device-source.circuit.tsx --routing-disabled --disable-parts-engine",
    "check:usbc-device-netlist": "node scripts/check-am3352-usbc-device.mjs",
    "check:usbc-device-evidence": "node scripts/summarize-am3352-usbc-device-checks.mjs",
    "build:usbc-routed-replay": "tsci build experiments/am3352-usbc-routed-replay.circuit.tsx --routing-disabled --disable-parts-engine",
    "check:usbc-routed-source": "node scripts/check-am3352-usbc-routed-source.mjs dist/diagnostics/am3352-usbc-routed-tuned-checked/circuit.json",
    "check:usbc-routed-evidence": "node scripts/summarize-am3352-usbc-routed-checks.mjs",
    "check:ddr-usbc-evidence": "node scripts/summarize-am3352-ddr-usbc-checks.mjs",
    "check:ddr-clock-evidence": "node scripts/summarize-am3352-ddr-usbc-clock-checks.mjs",
    "check:ddr-strobe-evidence": "node scripts/summarize-am3352-ddr-usbc-strobe-checks.mjs",
    "check:ddr-repaired-strobe-evidence": "node scripts/summarize-am3352-ddr-usbc-repaired-strobe-checks.mjs",
    "check:ddr-cke-access-evidence": "node scripts/summarize-am3352-cke-access-checks.mjs",
    "check:ddr-cke-joint-plane-evidence": "node scripts/summarize-am3352-cke-joint-plane-checks.mjs",
    "check:ddr-cke-matched-evidence": "node scripts/summarize-am3352-cke-matched-checks.mjs",
    "check:ddr-odt-evidence": "node scripts/summarize-am3352-odt-checks.mjs",
    "check:ddr-csn-evidence": "node scripts/summarize-am3352-csn-checks.mjs",
    "check:ddr-a5-evidence": "node scripts/summarize-am3352-single-command-checks.mjs checks/integrated/am3352-ddr-usbc-a5-nominal experiments/am3352-ddr-usbc-a5-nominal.circuit.tsx",
    "check:ddr-wen-evidence": "node scripts/summarize-am3352-single-command-checks.mjs checks/integrated/am3352-ddr-usbc-wen-nominal experiments/am3352-ddr-usbc-wen-nominal.circuit.tsx",
    "check:ddr-a3-bootstrap-evidence": "node scripts/summarize-am3352-single-command-checks.mjs checks/integrated/am3352-ddr-usbc-a3-bootstrap experiments/am3352-ddr-usbc-a3-bootstrap.circuit.tsx bootstrap",
    "check:ddr30-command-trials": "node scripts/summarize-am3352-ddr30-address-control-trials.mjs checks/integrated/am3352-ddr30-address-control-trial-status.json 572",
    "check:ddr-a6-bootstrap-evidence": "node scripts/summarize-am3352-single-command-checks.mjs checks/integrated/am3352-ddr-usbc-a6-bootstrap experiments/am3352-ddr-usbc-a6-bootstrap.circuit.tsx bootstrap",
    "check:ddr-bootstrap-command-trials": "node scripts/summarize-am3352-command-bootstrap-trials.mjs checks/integrated/am3352-ddr31-32-command-bootstrap-trial-status.json 613",
    "check:ddr-command-prefix-trials": "node scripts/summarize-am3352-command-prefix-trials.mjs checks/integrated/am3352-ddr32-casn-prefix-trial-status.json 625",
    "check:ddr-casn-neighbor-replan-trials": "node scripts/summarize-am3352-casn-neighbor-replan-trials.mjs checks/integrated/am3352-ddr32-casn-neighbor-replan-trial-status.json 662",
    "check:ddr-staged-wire-guards": "node scripts/validate-am3352-staged-wire-guards.mjs",
    "check:ddr-d3-signal-guards": "node scripts/validate-am3352-d3-signal-guards.mjs",
    "check:ddr-casn-coupled-evidence": "node scripts/summarize-am3352-casn-d3-coupled-checks.mjs checks/integrated/am3352-ddr-usbc-casn-nominal-d3-matched casn-nominal",
    "check:ddr-casn-coupled-trials": "node scripts/summarize-am3352-casn-d3-coupled-trials.mjs checks/integrated/am3352-ddr32-33-casn-d3-coupled-trial-status.json 688",
    "check:ddr-csn0-nominal-evidence": "node scripts/summarize-am3352-casn-d3-coupled-checks.mjs checks/integrated/am3352-ddr-usbc-casn-csn0-nominal-d3-matched csn0-nominal",
    "check:ddr33-coordinated-trials": "node scripts/summarize-am3352-ddr33-csn0-coordinated-trials.mjs",
    "check:ddr-class-spacing": "node scripts/check-am3352-ddr-class-spacing.mjs dist/diagnostics/am3352-ddr-usbc-d12-spacing-repaired-candidate/circuit.json checks/integrated/am3352-ddr33-d12-repaired-class-spacing.json",
    "check:ddr-d12-spacing-evidence": "node scripts/summarize-am3352-d12-spacing-checks.mjs",
    "check:ram-bottom-evidence": "node scripts/summarize-am3352-ram-bottom-checks.mjs",
    "check:ddr-d12-ram-bottom-trials": "node scripts/summarize-am3352-d12-ram-bottom-trials.mjs",
    "check:ddr-d12-ram-bottom-continuation": "node scripts/verify-am3352-d12-ram-bottom-continuation.mjs",
    "check:bottom-ddr-replay-evidence": "node scripts/summarize-am3352-bottom-negotiated-checks.mjs am3352-ram-bottom-flexible-fanout-747-replay",
    "check:bottom-ddr-electrical-review": "node scripts/check-am3352-bottom-spacing-and-nominal.mjs checks/integrated/am3352-ram-bottom-flexible-fanout-747-replay-check-summary.json checks/integrated/am3352-ram-bottom-flexible-fanout-747-replay-spacing-and-nominal-review.json",
    "check:bottom-ddr-trials": "node scripts/summarize-am3352-bottom-manual-trials.mjs checks/integrated/am3352-ram-bottom-flexible-fanout-747-replay-check-summary.json",
    "check:bottom-terminal-via-guard": "node scripts/validate-am3352-terminal-via-guard.mjs",
    "check:bottom-ddr-continuation": "node scripts/verify-am3352-bottom-manual-continuation.mjs",
    "build:latest-ddr-phases": "tsci build experiments/am3352-latest-bus-lanes-ddr-phases.circuit.tsx --disable-parts-engine --autorouter-debug --autorouter-phase DDR_RESET_BUS_LANES --autorouter-debug-dir dist/am3352-latest-bus-lanes-native-phases --autorouter-dump-srj all --autorouter-timeout 60s",
    "build:latest-ddr33-phase": "node scripts/run-am3352-latest-ddr-phase.mjs experiments/am3352-latest-bus-lanes-ddr33-fixed-pairs.circuit.tsx dist/am3352-latest-ddr33-native-phase DDR_COMMAND_CLOCK_BUS_LANES 120",
    "check:latest-tscircuit-upgrade": "node scripts/check-am3352-ddr-active-source.mjs dist/index/circuit.json checks/integrated/tscircuit-upgrade-active-equivalence.json && tsci check shorts dist/index/circuit.json --mode gerber --layer all"
  },
  "devDependencies": {
    "@tscircuit/capacity-autorouter": "0.0.962",
    "@tscircuit/checks": "0.0.242",
    "@tscircuit/cli": "0.1.2258",
    "@tscircuit/core": "0.0.2107",
    "circuit-json": "0.0.520",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.179.1",
    "tscircuit": "0.0.2759",
    "typescript": "5.9.3",
    "@tscircuit/props": "0.0.695"
  },
  "author": "abse",
  "overrides": {
    "@tscircuit/checks": "0.0.242",
    "@tscircuit/core": "0.0.2107",
    "@tscircuit/props": "0.0.695",
    "@tscircuit/cli": "0.1.2258"
  }
}
