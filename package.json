{
  "name": "@tsci/abse.g350-linux-handheld",
  "version": "1.0.0",
  "description": "G350-style Linux handheld PCB with hand-drawn Pi Zero 2 W interface, integrated charger, boost, audio, battery monitor and front controls",
  "main": "index.circuit.tsx",
  "keywords": [
    "tscircuit",
    "circuit",
    "pcb",
    "electronics"
  ],
  "scripts": {
    "dev": "tsci dev",
    "build": "tsci build index.circuit.tsx --autorouter-debug --autorouter-dump-srj all --pcb-png --schematic-png --kicad-project",
    "snapshot": "tsci snapshot",
    "snapshot:update": "tsci snapshot --update",
    "start": "tsci dev",
    "typecheck": "tsc --noEmit",
    "check:shorts": "tsci check shorts dist/index/circuit.json",
    "fabrication": "node scripts/fabrication.mjs"
  },
  "devDependencies": {
    "tscircuit": "0.0.2706",
    "typescript": "5.9.3"
  },
  "author": "abse"
}
