+/** Resolve a blocked package front from existing continuous-scene vertices.
+ * The whole entry capsule reserves both offset rails, not only a clear point. */
+export function compactFrontPortals(
+  scene: VectorScene,
+  front: Point,
+  packageBounds: SimpleRouteJson["bounds"] | undefined,
+  axis: "x" | "y",
+  direction: number,
+  envelope: number,
+  ownCenter: Point,
+  otherCenter: Point,
+): Point[] {
+  if (scene.visible(front, front)) return [front]
+  if (!packageBounds) return []
+  const crossAxis = axis === "x" ? "y" : "x"
+  const low = crossAxis === "x" ? packageBounds.minX : packageBounds.minY
+  const high = crossAxis === "x" ? packageBounds.maxX : packageBounds.maxY
+  const cost = (point: Point) =>
+    2 * distance(point, ownCenter) + distance(point, otherCenter)
+  return scene.vertices().filter((point) => {
+    const outward = direction * (point[axis] - front[axis])
+    const projection = { ...point, [axis]: front[axis] }
+    return point[crossAxis] >= low && point[crossAxis] <= high &&
+      outward >= 0 && outward <= 2 * envelope &&
+      scene.visible(point, projection)
+  }).filter((point, index, choices) =>
+    choices.findIndex((other) => distance(point, other) < 1e-8) === index,
+  ).sort((a, b) => cost(a) - cost(b)).slice(0, 4)
+}
+
+export type CoupledGridAllocationEvent = Readonly<Record<string, unknown>>
+let coupledGridAllocationObserver: ((event: CoupledGridAllocationEvent) => void) | undefined
+/** Opt-in scalar allocation diagnostics only; no observer exists by default. */
+export function observeCoupledGridAllocations(observer: (event: CoupledGridAllocationEvent) => void) {
+  const previous = coupledGridAllocationObserver
+  coupledGridAllocationObserver = observer
+  return () => { coupledGridAllocationObserver = previous }
+}
